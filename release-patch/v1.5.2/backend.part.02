+	if !decodeJSON(writer, request, &input) {
+		return
+	}
+	response, ok := a.callFilesystemHelper(writer, request, "filesystem.delete", input.Path)
+	if !ok {
+		return
+	}
+	a.audit(request, "filesystem.delete", input.Path, "success", map[string]any{
+		"name":    response.Data["name"],
+		"kind":    response.Data["kind"],
+		"entries": response.Data["entries"],
+	})
+	writeJSON(writer, http.StatusOK, response.Data)
+}
