move_dialog=r'''<dialog id="move-dialog" class="modal operation-modal">
      <form id="move-form" class="modal-card operation-card">
        <div class="operation-heading"><h3>Move</h3><button type="button" class="operation-close" data-close-dialog aria-label="Close">×</button></div>
        <div class="operation-item"><span>Item</span><strong id="move-source-path"></strong></div>
        <label>Destination<span class="destination-field"><span class="destination-icon" aria-hidden="true">▣</span><input id="move-destination-input" maxlength="4096" autocomplete="off" required><button class="destination-browse" type="button" data-destination-browse="move" title="Choose destination folder" aria-label="Choose destination folder">▱</button></span></label>
        <p class="operation-hint">No overwrite · Cross-filesystem moves are blocked.</p>
        <div id="move-error" class="alert" role="alert" hidden></div>
        <div class="modal-actions"><button type="button" class="ghost compact" data-close-dialog>Cancel</button><button type="submit" class="primary compact-primary">Move</button></div>
      </form>
    </dialog>'''
delete_dialog=r'''<dialog id="delete-dialog" class="modal operation-modal delete-modal">
      <form id="delete-form" class="modal-card operation-card">
        <div class="operation-heading"><h3>Delete</h3><button type="button" class="operation-close" data-close-dialog aria-label="Close">×</button></div>
        <div class="operation-item"><span>Item</span><strong id="delete-source-path"></strong></div>
        <p class="delete-warning">This permanently deletes the selected item. Folders are removed recursively after guarded validation.</p>
        <div id="delete-error" class="alert" role="alert" hidden></div>
        <div class="modal-actions"><button type="button" class="ghost compact" data-close-dialog>Cancel</button><button type="submit" class="danger-button">Delete</button></div>
      </form>
    </dialog>'''
picker_dialog=r'''<dialog id="destination-dialog" class="modal destination-modal">
      <div class="modal-card destination-card">
        <div class="operation-heading"><h3>Choose destination</h3><button type="button" class="operation-close" data-close-dialog aria-label="Close">×</button></div>
        <div class="destination-nav"><button id="destination-up-button" class="command-icon" type="button">↑</button><code id="destination-current-path">/</code></div>
    