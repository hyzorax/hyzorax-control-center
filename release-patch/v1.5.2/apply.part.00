        <div class="operation-item"><span>Item</span><strong id="copy-source-path"></strong></div>
        <label>Destination<span class="destination-field"><span class="destination-icon" aria-hidden="true">▣</span><input id="copy-destination-input" name="destination" maxlength="4096" autocomplete="off" required><button class="destination-browse" type="button" data-destination-browse="copy" title="Choose destination folder" aria-label="Choose destination folder">▱</button></span></label>
        <label>New name <small>(optional)</small><input id="copy-name-input" name="name" maxlength="255" autocomplete="off"></label>
        <p class="operation-hint">No overwrite · maximum 256 MB / 5,000 entries.</p>
        <div id="copy-error" class="alert" role="alert" hidden></div>
        <div class="modal-actions"><button type="button" class="ghost compact" data-close-dialog>Cancel</button><button type="submit" class="primary compact-primary">Copy</button></div>
      </form>
