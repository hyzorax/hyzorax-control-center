+
+func TestGuardedFilesystemDeleteFileAndDirectory(t *testing.T) {
+	root := t.TempDir()
+	filePath := filepath.Join(root, "remove.txt")
+	if err := os.WriteFile(filePath, []byte("delete-safe\n"), 0o640); err != nil {
+		t.Fatal(err)
+	}
+	deleted, operationError := filesystemDelete(context.Background(), filePath)
+	if operationError != nil {
+		t.Fatalf("delete file failed: %+v", operationError)
+	}
+	if deleted["path"] != filePath || deleted["kind"] != "file" {
+		t.Fatalf("unexpected delete file response: %#v", deleted)
+	}
+	if _, err := os.Lstat(filePath); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("deleted file still exists: %v", err)
+	}
+
+	directoryPath := filepath.Join(root, "tree")
+	if err := os.MkdirAll(filepath.Join(directoryPath, "nested"), 0o750); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(directoryPath, "nested", "config.ini"), []byte("enabled=true\n"), 0o640); err != nil {
+		t.Fatal(err)
+	}
+	deleted, operationError = filesystemDelete(context.Background(), directoryPath)
+	if operationError != nil {
+		t.Fatalf("delete directory failed: %+v", operationError)
+	}
+	if deleted["kind"] != "directory" {
+		t.Fatalf("unexpected delete directory response: %#v", deleted)
+	}
+	if entries, ok := deleted["entries"].(int); !ok || entries != 3 {
+		t.Fatalf("unexpected deleted entry count: %#v", deleted["entries"])
+	}
+	if _, err := os.Lstat(directoryPath); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("deleted directory still exists: %v", err)
+	}
+}
+
+func TestGuardedFilesystemDeleteRejectsUnsafeTargets(t *testing.T) {
+	root := t.TempDir()
+	linkTarget := filepath.Join(root, "target.txt")
+	if err := os.WriteFile(linkTarget, []byte("keep\n"), 0o640); err != nil {
+		t.Fatal(err)
+	}
+	linkPath := filepath.Join(root, "link.txt")
+	if err := os.Symlink(linkTarget, linkPath); err != nil {
+		t.Fatal(err)
+	}
+	if _, operationError := filesystemDelete(context.Background(), linkPath); operationError == nil || operationError.Code != "symlink_denied" {
+		t.Fatalf("symlink delete was not rejected: %+v", operationError)
+	}
+	if contents, err := os.ReadFile(linkTarget); err != nil || string(contents) != "keep\n" {
+		t.Fatalf("symlink target changed: %q err=%v", contents, err)
+	}
+
+	fifoPath := filepath.Join(root, "pipe")
+	if err := unix.Mkfifo(fifoPath, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, operationError := filesystemDelete(context.Background(), fifoPath); operationError == nil || operationError.Code != "unsupported_file_type" {
+		t.Fatalf("special-file delete was not rejected: %+v", operationError)
+	}
+
+	if _, operationError := filesystemDelete(context.Background(), "/"); operationError == nil || operationError.Code != "root_path_denied" {
+		t.Fatalf("root delete was not rejected: %+v", operationError)
+	}
+	if _, operationError := filesystemDelete(context.Background(), "/opt/hyzorax-control"); operationError == nil || operationError.Code != "protected_path_denied" {
+		t.Fatalf("protected HYZoraX path delete was not rejected: %+v", operationError)
+	}
+}
+
+func TestFilesystemListMarksProtectedPathsNotDeletable(t *testing.T) {
+	if !isProtectedFilesystemDeletePath("/opt/hyzorax-control") {
+		t.Fatal("HYZoraX control root must remain protected from delete")
+	}
+	if isProtectedFilesystemDeletePath("/opt/hyzorax-control/example.txt") {
+		t.Fatal("ordinary child paths should not be globally protected")
+	}
+}
