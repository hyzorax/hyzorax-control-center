ourceAt(parentFD, name)
+	if operationError != nil {
+		return operationError
+	}
+	if uint64(source.Stat.Dev) != allowedDev {
+		return &Error{Code: "mount_boundary_denied", Message: "delete source contains a mount-boundary path"}
+	}
+	if reserveError := budget.reserve(); reserveError != nil {
+		return reserveError
+	}
+	if source.Kind == "file" {
+		return nil
+	}
+	fd, err := unix.Openat2(parentFD, name, &unix.OpenHow{
+		Flags:   uint64(unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+		Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+	})
+	if err != nil {
+		return filesystemError(err, "delete source directory could not be opened")
+	}
+	directory := os.NewFile(uintptr(fd), name)
+	defer directory.Close()
+	for {
+		entries, readError := directory.ReadDir(128)
+		for _, entry := range entries {
+			if operationError := filesystemDeletePreflightAt(ctx, int(directory.Fd()), entry.Name(), allowedDev, budget); operationError != nil {
+				return operationError
+			}
+		}
+		if errors.Is(readError, io.EOF) {
+			break
+		}
+		if readError != nil {
+			return filesystemError(readError, "delete source directory could not be read")
+		}
+	}
+	return nil
+}
+
+func filesystemDeleteTempName() (string, error) {
+	buffer := make([]byte, 8)
+	if _, err := rand.Read(buffer); err != nil {
+		return "", err
+	}
+	return ".hyzorax-delete-" + hex.EncodeToString(buffer) + ".tmp", nil
+}
+
+func removeFilesystemDeleteTreeAt(parentFD int, name string, allowedDev uint64) error {
+	var stat unix.Stat_t
+	if err := unix.Fstatat(parentFD, name, &stat, unix.AT_SYMLINK_NOFOLLOW); err != nil {
+		return err
+	}
+	if uint64(stat.Dev) != allowedDev {
+		return unix.EXDEV
+	}
+	switch stat.Mode & unix.S_IFMT {
+	case unix.S_IFREG:
+		return unix.Unlinkat(parentFD, name, 0)
+	case unix.S_IFDIR:
+		fd, err := unix.Openat2(parentFD, name, &unix.OpenHow{
+			Flags:   uint64(unix.O_RDONLY | unix.O_DIRECTORY | unix.O_CLOEXEC | unix.O_NOFOLLOW),
+			Resolve: unix.RESOLVE_BENEATH | unix.RESOLVE_NO_MAGICLINKS | unix.RESOLVE_NO_SYMLINKS,
+		})
+		if err != nil {
+			return err
+		}
+		directory := os.NewFile(uintptr(fd), name)
+		for {
+			entries, readError := directory.ReadDir(128)
+			for _, entry := range entries {
+				if err := removeFilesystemDeleteTreeAt(int(directory.Fd()), entry.Name(), allowedDev); err != nil {
+					directory.Close()
+					return err
+				}
+			}
+			if errors.Is(readError, io.EOF) {
+				break
+			}
+			if readError != nil {
+				directory.Close()
+				return readError
+			}
+		}
+		if err := directory.Close(); err != nil {
+			return err
+		}
+		return unix.Unlinkat(parentFD, name, unix.AT_REMOVEDIR)
+	case unix.S_IFLNK:
+		return unix.ELOOP
+	default:
+		return unix.EPERM
+	}
+}
+
 type filesystemCopySource struct {
 	Info os.FileInfo
 	Stat *syscall.Stat_t
